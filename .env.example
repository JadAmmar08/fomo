AI_CLASSIFIER_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fomo
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Same value as MICROSOFT_CLIENT_ID — not secret, exposed to the browser so the native
# OneDrive file picker widget can authenticate client-side.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
# Google API key restricted to the Picker API (Cloud Console > Credentials), plus an
# HTTP referrer restriction to the app's domain. Distinct from GOOGLE_CLIENT_ID/SECRET
# — this is a public, referrer-locked key for the client-side Drive Picker widget.
NEXT_PUBLIC_GOOGLE_API_KEY=
# Shared secret echoed back by Google Drive (channel token) and Microsoft Graph
# (clientState) on every file-change webhook, so app/api/webhooks/* can verify a
# notification actually came from that provider before acting on it.
FILE_WATCH_WEBHOOK_SECRET=
